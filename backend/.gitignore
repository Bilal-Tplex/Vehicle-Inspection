# Dependencies
node_modules/

# Runtime data. The SQLite file holds real password hashes and submitted
# inspections, and is recreated by `npm start` / `npm run seed` on first boot —
# there is no reason for it to be in version control.
data/
*.db
*.db-wal
*.db-shm

# Media uploaded by evaluators. Regenerated by using the app; committing it
# would put vehicle photos and paperwork into the repository.
storage/

# Local overrides
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
